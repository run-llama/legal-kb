# --- Database ---------------------------------------------------------------
# Postgres connection string. Local dev example:
#   postgres://postgres:postgres@localhost:5432/legal_kb
DATABASE_URL=

# --- Encryption -------------------------------------------------------------
# 32-byte hex key (64 hex chars) used to encrypt user-supplied API keys
# at rest with AES-256-GCM. Generate with: `openssl rand -hex 32`.
# WARNING: rotating this invalidates all stored user keys.
ENCRYPTION_KEY=

# --- WorkOS (AuthKit) -------------------------------------------------------
# From your WorkOS dashboard. VITE_* vars are baked in at build time.
VITE_WORKOS_CLIENT_ID=
# Your Custom Authentication Domain in production; default in dev is fine.
VITE_WORKOS_API_HOSTNAME=

# --- Runtime tuning (optional) ----------------------------------------------
# Keep Bun's HTTP idle timeout long enough for streaming chat responses.
# Default is 30s; bump to 5 minutes if you see streams cut off.
# NITRO_BUN_IDLE_TIMEOUT=300000
